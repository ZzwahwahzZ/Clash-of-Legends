+        tail.extend_from_slice(b"STEP2");
+        tail.extend_from_slice(&[0u8; 8]);
+        assert!(C3Mesh::parse(*b"PHY4", &minimal_phy4_with_tail(&tail)).is_ok());
+    }
 
