+    fn minimal_phy4_with_tail(tail: &[u8]) -> Vec<u8> {
+        fn push_u32(bytes: &mut Vec<u8>, value: u32) {
+            bytes.extend_from_slice(&value.to_le_bytes());
+        }
+        let mut bytes = Vec::new();
+        push_u32(&mut bytes, 4);
+        bytes.extend_from_slice(b"test");
+        for value in [0, 0, 0, 0, 0, 0] {
+            push_u32(&mut bytes, value);
+        }
+        bytes.extend_from_slice(&[0u8; 24]); // bounds
+        bytes.extend_from_slice(&[0u8; 64]); // initial matrix
+        push_u32(&mut bytes, 1); // texture rows
+        push_u32(&mut bytes, 0); // transparency keys
+        push_u32(&mut bytes, 0); // draw keys
+        push_u32(&mut bytes, 0); // texture keys
+        bytes.extend_from_slice(tail);
+        bytes
+    }
+
+    #[test]
+    fn accepts_observed_c3_mesh_extension_markers() {
+        for marker in [b"BILB", b"BIB2", b"BIB3", b"BIB4"] {
+            let mut tail = b"STEP".to_vec();
+            tail.extend_from_slice(&[0u8; 8]);
+            tail.extend_from_slice(marker);
+            assert!(C3Mesh::parse(*b"PHY4", &minimal_phy4_with_tail(&tail)).is_ok());
+        }
+
+        let mut tail = b"STEP".to_vec();
+        tail.extend_from_slice(&[0u8; 8]);
+        tail.extend_from_slice(b"2SIDBILB");
+        let mesh = C3Mesh::parse(*b"PHY4", &minimal_phy4_with_tail(&tail)).unwrap();
+        assert_eq!(mesh.extension_tag, Some(*b"2SID"));
+    }
+
