+        // C3 PHY chunks can carry several optional trailing markers. STEP1
+        // and STEP2 are five-byte tags followed by two floats; check them
+        // before STEP because they share its four-byte prefix.
+        let mut extension_tag = None;
+        loop {
+            if reader.remaining() >= 5 {
+                let tag = reader.peek_exact(5)?;
+                if tag == b"STEP1" || tag == b"STEP2" {
+                    reader.skip(13)?;
+                    continue;
+                }
+            }
+            if reader.remaining() >= 4 && reader.peek_exact(4)? == b"STEP" {
+                reader.skip(12)?;
+                continue;
+            }
+            if reader.remaining() < 4 {
+                break;
+            }
+            let tag = reader.peek_exact(4)?;
+            if tag == b"2SID" {
+                extension_tag = Some(*b"2SID");
+                reader.skip(4)?;
+                continue;
+            }
+            // These opaque four-byte markers occur in the supplied C3
+            // corpus after 2SID or on their own. They carry no payload in
+            // the observed files; retain strict rejection of unknown tags.
+            if tag == b"BILB" || tag == b"BIB2" || tag == b"BIB3" || tag == b"BIB4" {
+                reader.skip(4)?;
+                continue;
+            }
+            break;
+        }
