  {
   "cell_type": "markdown",
   "metadata": {},
   "id": "col-redesign-head",
   "source": [
    "## 5A. AI redesign of reference images (before 3D generation)\n",
    "This stage preserves each original input, creates a newly designed image with SDXL image-to-image, saves a side-by-side comparison and metrics, then changes each image path so the existing Hunyuan3D workers consume the redesigned image. The similarity score is a visual diagnostic, not a legal clearance test. GPU 1 is released before the Hunyuan3D workers start."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "id": "col-redesign-stage",
   "source": [
    "# Stage 5A: create genuinely redesigned image inputs before Hunyuan3D.\n",
    "# The source images remain untouched. Hunyuan3D receives only the newly generated images.\n",
    "from pathlib import Path\n",
    "from PIL import Image, ImageOps, ImageDraw\n",
    "import json, os, re, gc, time\n",
    "import numpy as np\n",
    "import torch\n",
    "from diffusers import AutoPipelineForImage2Image\n",
    "from skimage.metrics import structural_similarity\n",
    "\n",
    "REDESIGN_MODEL = \"stabilityai/stable-diffusion-xl-base-1.0\"\n",
    "REDESIGN_ROOT = Path(\"/kaggle/working/hy3d_redesign\")\n",
    "REDESIGN_ROOT.mkdir(parents=True, exist_ok=True)\n",
    "REDESIGN_STRENGTH = 0.64\n",
    "REDESIGN_STEPS = 28\n",
    "REDESIGN_GUIDANCE = 6.5\n",
    "REDESIGN_SEED = 73184\n",
    "REDESIGN_MAX_SIDE = 1024\n",
    "REDESIGN_RETRY_SIMILARITY = 0.93\n",
    "REDESIGN_PROMPTS = {}  # Optional: {\"asset_file_name\": \"your asset-specific redesign prompt\"}\n",
    "REDESIGN_SKIP_EXISTING = True\n",
    "\n",
    "if torch.cuda.device_count() < 2:\n",
    "    raise RuntimeError(\"The existing dual-T4 notebook requires two GPUs; image redesign is assigned to GPU 1.\")\n",
    "\n",
    "def prepare_sdxl_image(source_path):\n",
    "    im = Image.open(source_path)\n",
    "    if im.mode == \"RGBA\":\n",
    "        bg = Image.new(\"RGB\", im.size, (128, 128, 128))\n",
    "        bg.paste(im, mask=im.getchannel(\"A\"))\n",
    "        im = bg\n",
    "    else:\n",
    "        im = im.convert(\"RGB\")\n",
    "    # Keep the complete object and its aspect ratio; pad rather than crop.\n",
    "    im = ImageOps.pad(im, (1024, 1024), method=Image.Resampling.LANCZOS, color=(128, 128, 128), centering=(0.5, 0.5))\n",
    "    return im\n",
    "\n",
    "def image_metrics(original, redesigned):\n",
    "    a = np.asarray(ImageOps.fit(original.convert(\"RGB\"), (512, 512)), dtype=np.uint8)\n",
    "    b = np.asarray(ImageOps.fit(redesigned.convert(\"RGB\"), (512, 512)), dtype=np.uint8)\n",
    "    similarity = float(structural_similarity(a, b, channel_axis=2, data_range=255))\n",
    "    mean_abs_diff = float(np.abs(a.astype(np.float32) - b.astype(np.float32)).mean())\n",
    "    return {\"ssim_similarity\": similarity, \"mean_absolute_pixel_difference\": mean_abs_diff}\n",
    "\n",
    "def asset_prompt(name):\n",
    "    custom = REDESIGN_PROMPTS.get(name)\n",
    "    if custom:\n",
    "        return custom\n",
    "    category = re.sub(r\"[_-]+\", \" \", name).strip()\n",
    "    return (\n",
    "        f\"Create a genuinely original, production-quality fantasy MMORPG game asset concept for: {category}. \"\n",
    "        \"Preserve only the broad gameplay function and subject category. Invent a new silhouette, proportions, \"\n",
    "        \"construction, surface geometry, ornaments, materials, textures, and decorative language. \"\n",
    "        \"Do not reproduce the exact reference design or its distinctive details. \"\n",
    "        \"Classic colorful East Asian fantasy game atmosphere, coherent stylized 3D game-art presentation, \"\n",
    "        \"single complete subject, centered, full object visible, three-quarter view, neutral plain studio background, \"\n",
    "        \"clean readable shape, detailed craftsmanship, no text, no logo, no watermark.\"\n",
    "    )\n",
    "\n",
    "print(\"Loading SDXL image-to-image model on GPU 1. This runs before either Hunyuan3D worker starts.\")\n",
    "redesign_pipe = AutoPipelineForImage2Image.from_pretrained(\n",
    "    REDESIGN_MODEL,\n",
    "    torch_dtype=torch.float16,\n",
    "    variant=\"fp16\",\n",
    "    use_safetensors=True,\n",
    "    add_watermarker=False,\n",
    ")\n",
    "redesign_pipe.enable_model_cpu_offload(gpu_id=1)\n",
    "redesign_pipe.enable_vae_slicing()\n",
    "redesign_pipe.enable_vae_tiling()\n",
    "\n",
    "redesign_reports = []\n",
    "for index, item in enumerate(images):\n",
    "    name = item[\"name\"]\n",
    "    original_path = Path(item[\"path\"])\n",
    "    asset_dir = REDESIGN_ROOT / name\n",
    "    asset_dir.mkdir(parents=True, exist_ok=True)\n",
    "    original_copy = asset_dir / \"reference_original.png\"\n",
    "    redesigned_path = asset_dir / \"redesigned_input.png\"\n",
    "    comparison_path = asset_dir / \"original_vs_redesigned.png\"\n",
    "\n",
    "    if not original_path.is_file():\n",
    "        raise FileNotFoundError(f\"Input image is missing: {original_path}\")\n",
    "\n",
    "    original = Image.open(original_path).convert(\"RGB\")\n",
    "    original.save(original_copy)\n",
    "\n",
    "    if REDESIGN_SKIP_EXISTING and redesigned_path.is_file():\n",
    "        redesigned = Image.open(redesigned_path).convert(\"RGB\")\n",
    "        print(f\"{name}: reusing completed redesigned image.\")\n",
    "    else:\n",
    "        init_image = prepare_sdxl_image(original_path)\n",
    "        prompt = asset_prompt(name)\n",
    "        result = redesign_pipe(\n",
    "            prompt=prompt,\n",
    "            negative_prompt=\"exact copy, identical design, screenshot, game UI, text, logo, watermark, cropped object, duplicate objects, blurry, low quality\",\n",
    "            image=init_image,\n",
    "            strength=REDESIGN_STRENGTH,\n",
    "            guidance_scale=REDESIGN_GUIDANCE,\n",
    "            num_inference_steps=REDESIGN_STEPS,\n",
    "            generator=torch.Generator(device=\"cuda:1\").manual_seed(REDESIGN_SEED + index),\n",
    "        ).images[0].convert(\"RGB\")\n",
    "        metrics = image_metrics(original, result)\n",
    "        # If the result remains visually too close, retry once with stronger redesign.\n",
    "        if metrics[\"ssim_similarity\"] >= REDESIGN_RETRY_SIMILARITY:\n",
    "            result = redesign_pipe(\n",
    "                prompt=prompt,\n",
    "                negative_prompt=\"exact copy, identical design, screenshot, game UI, text, logo, watermark, cropped object, duplicate objects, blurry, low quality\",\n",
    "                image=init_image,\n",
    "                strength=0.76,\n",
    "                guidance_scale=7.0,\n",
    "                num_inference_steps=32,\n",
    "                generator=torch.Generator(device=\"cuda:1\").manual_seed(REDESIGN_SEED + 10000 + index),\n",
    "            ).images[0].convert(\"RGB\")\n",
    "            metrics = image_metrics(original, result)\n",
    "        result.save(redesigned_path)\n",
    "        del init_image, result\n",
    "        torch.cuda.empty_cache()\n",
    "        gc.collect()\n",
    "\n",
    "    redesigned = Image.open(redesigned_path).convert(\"RGB\")\n",
    "    metrics = image_metrics(original, redesigned)\n",
    "    preview_original = ImageOps.fit(original, (512, 512))\n",
    "    preview_redesigned = ImageOps.fit(redesigned, (512, 512))\n",
    "    preview = Image.new(\"RGB\", (1024, 560), \"white\")\n",
    "    preview.paste(preview_original, (0, 32))\n",
    "    preview.paste(preview_redesigned, (512, 32))\n",
    "    draw = ImageDraw.Draw(preview)\n",
    "    draw.text((12, 10), \"ORIGINAL REFERENCE\", fill=\"black\")\n",
    "    draw.text((524, 10), \"REDESIGNED IMAGE\", fill=\"black\")\n",
    "    preview.save(comparison_path)\n",
    "\n",
    "    report = {\n",
    "        \"asset\": name,\n",
    "        \"source_file\": str(original_path),\n",
    "        \"original_copy\": str(original_copy),\n",
    "        \"redesigned_image\": str(redesigned_path),\n",
    "        \"comparison_preview\": str(comparison_path),\n",
    "        \"model\": REDESIGN_MODEL,\n",
    "        \"strength\": REDESIGN_STRENGTH,\n",
    "        \"metrics\": metrics,\n",
    "        \"note\": \"Similarity metrics are visual diagnostics only; they do not determine copyright status or permission to redistribute.\"\n",
    "    }\n",
    "    redesign_reports.append(report)\n",
    "    item[\"original_path\"] = str(original_copy)\n",
    "    item[\"redesigned_path\"] = str(redesigned_path)\n",
    "    item[\"name\"] = f\"{name}_redesigned\"  # keep new outputs separate from any older meshes made from the untouched reference\n",
    "    item[\"path\"] = str(redesigned_path)  # existing shape_worker and paint_worker now consume the redesigned image\n",
    "    print(f\"{name}: redesigned | SSIM={metrics['ssim_similarity']:.3f} | mean pixel difference={metrics['mean_absolute_pixel_difference']:.1f}\")\n",
    "\n",
    "report_path = REDESIGN_ROOT / \"redesign_report.json\"\n",
    "report_path.write_text(json.dumps(redesign_reports, indent=2), encoding=\"utf-8\")\n",
    "\n",
    "# Release the redesign model before the two Hunyuan3D workers load their own models.\n",
    "del redesign_pipe\n",
    "gc.collect()\n",
    "torch.cuda.empty_cache()\n",
    "print(f\"Image redesign complete: {len(images)} input(s). Hunyuan3D will now use the redesigned images.\")\n",
    "print(\"Originals, redesigned images, side-by-side previews, and the report are in:\", REDESIGN_ROOT)"
   ]
  },
