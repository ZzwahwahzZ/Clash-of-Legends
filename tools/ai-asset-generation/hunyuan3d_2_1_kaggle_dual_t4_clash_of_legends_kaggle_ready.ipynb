   "source": [
    "import glob, os, re, shutil, zipfile, hashlib\n",
    "from pathlib import Path\n",
    "from PIL import Image\n",
    "\n",
    "REPO = \"/tmp/Hunyuan3D-2.1\"\n",
    "OUT_DIR = \"/kaggle/working/hy3d_out\"\n",
    "IMAGE_EXTRACT_DIR = Path(\"/kaggle/working/conquer_original_reference_images\")\n",
    "IMAGE_EXTRACT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "SETTINGS = dict(\n",
    "    # shape (GPU 0)\n",
    "    steps=30,\n",
    "    guidance_scale=5.0,\n",
    "    octree_resolution=256,\n",
    "    num_chunks=8000,\n",
    "    seed=1234,\n",
    "    max_faces=40000,\n",
    "    force_rembg=False,\n",
    "    # texture (GPU 1); conservative settings for a 16 GB T4.\n",
    "    texture_views=6,\n",
    "    texture_resolution=512,\n",
    "    skip_existing=True,\n",
    ")\n",
    "MAX_IMAGES = 50\n",
    "IMAGE_EXTS = (\".png\", \".jpg\", \".jpeg\", \".webp\", \".bmp\")\n",
    "\n",
    "# Locate the attached Hunyuan weights Dataset so its files are never treated as reference images.\n",
    "weights_root = Path(DATASET).resolve() if DATASET else None\n",
    "\n",
    "def is_inside(path, root):\n",
    "    try:\n",
    "        Path(path).resolve().relative_to(Path(root).resolve())\n",
    "        return True\n",
    "    except (ValueError, OSError):\n",
    "        return False\n",
    "\n",
    "# Extract attached reference-image ZIP archives safely. The weights Dataset is excluded.\n",
    "zip_files = []\n",
    "for z in Path(\"/kaggle/input\").rglob(\"*.zip\"):\n",
    "    if weights_root and is_inside(z, weights_root):\n",
    "        continue\n",
    "    zip_files.append(z)\n",
    "\n",
    "for archive in sorted(zip_files):\n",
    "    try:\n",
    "        with zipfile.ZipFile(archive) as zf:\n",
    "            for member in zf.infolist():\n",
    "                if not member.filename or member.is_dir():\n",
    "                    continue\n",
    "                target = (IMAGE_EXTRACT_DIR / member.filename).resolve()\n",
    "                if not is_inside(target, IMAGE_EXTRACT_DIR):\n",
    "                    raise RuntimeError(f\"Unsafe path in ZIP archive: {member.filename}\")\n",
    "            zf.extractall(IMAGE_EXTRACT_DIR)\n",
    "        print(f\"Extracted reference archive: {archive.name}\")\n",
    "    except zipfile.BadZipFile:\n",
    "        print(f\"Skipping invalid ZIP: {archive}\")\n",
    "\n",
    "# Collect supported images from attached Kaggle inputs and the extracted reference archive.\n",
    "candidate_roots = [Path(\"/kaggle/input\"), IMAGE_EXTRACT_DIR]\n",
    "paths = []\n",
    "for root in candidate_roots:\n",
    "    if not root.exists():\n",
    "        continue\n",
    "    for p in root.rglob(\"*\"):\n",
    "        if not p.is_file() or p.suffix.lower() not in IMAGE_EXTS:\n",
    "            continue\n",
    "        if weights_root and is_inside(p, weights_root):\n",
    "            continue\n",
    "        paths.append(str(p))\n",
    "\n",
    "# Verify image contents and remove exact duplicates by SHA-256.\n",
    "images, seen_hashes, seen_names = [], set(), set()\n",
    "invalid_images = []\n",
    "for p in sorted(set(paths)):\n",
    "    try:\n",
    "        digest = hashlib.sha256(Path(p).read_bytes()).hexdigest()\n",
    "        if digest in seen_hashes:\n",
    "            continue\n",
    "        with Image.open(p) as im:\n",
    "            im.verify()\n",
    "        seen_hashes.add(digest)\n",
    "        base = re.sub(r\"[^A-Za-z0-9_-]+\", \"_\", Path(p).stem).strip(\"_\") or \"reference\"\n",
    "        name, suffix = base, 1\n",
    "        while name in seen_names:\n",
    "            suffix += 1\n",
    "            name = f\"{base}_{suffix}\"\n",
    "        seen_names.add(name)\n",
    "        images.append({\"name\": name, \"path\": p})\n",
    "    except Exception as exc:\n",
    "        invalid_images.append((p, str(exc)))\n",
    "\n",
    "if invalid_images:\n",
    "    print(f\"Skipped {len(invalid_images)} unreadable or unsupported image file(s).\")\n",
    "if not images:\n",
    "    raise RuntimeError(\n",
    "        \"No valid reference images were found. In Kaggle, attach the \"\n",
    "        \"'Conquer Original Reference Images' Dataset (ZIP or extracted image files), \"\n",
    "        \"then rerun this cell. The Hunyuan3D weights Dataset is detected and excluded.\"\n",
    "    )\n",
    "\n",
    "images = images[:MAX_IMAGES]\n",
    "print(f\"Ready: {len(images)} unique, verified reference image(s).\")\n",
    "for item in images:\n",
    "    print(f\"  {item['name']}: {item['path']}\")\n",
    ""
   ],
