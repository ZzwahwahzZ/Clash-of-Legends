    "## 8. Upload validated GLB assets to the project's Hugging Face Dataset\n",
    "\n",
    "Before running this cell, add a Kaggle Secret named `HF_TOKEN` containing your Hugging Face write token. Do not paste the token into notebook code or output. The destination Dataset is fixed to `ZzwahwahzZ/clash-of-legends-assets`.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "id": "col-upload",
   "source": [
    "from pathlib import Path\n",
    "import json, os, time\n",
    "from kaggle_secrets import UserSecretsClient\n",
    "from huggingface_hub import HfApi\n",
    "\n",
    "DATASET_ID = 'ZzwahwahzZ/clash-of-legends-assets'\n",
    "OUT_DIR = Path('/kaggle/working/hy3d_out')\n",
    "secrets = UserSecretsClient()\n",
    "hf_token = secrets.get_secret('HF_TOKEN')\n",
    "if not hf_token:\n",
    "    raise RuntimeError('Kaggle Secret HF_TOKEN is missing. Add it in Add-ons → Secrets; never paste it into a cell.')\n",
    "\n",
    "glbs = sorted(OUT_DIR.glob("*/textured_mesh.glb"))\n",
    "if not glbs:\n",
    "    raise RuntimeError('No textured_mesh.glb files found. Check the worker logs; nothing was uploaded.')\n",
    "\n",
    "validated = []\n",
    "for p in glbs:\n",
    "    if p.stat().st_size < 1024:\n",
    "        print(f'SKIP tiny/invalid file: {p}')\n",
    "        continue\n",
    "    with p.open('rb') as f:\n",
    "        magic = f.read(4)\n",
    "    if magic != b'glTF':\n",
    "        print(f'SKIP invalid GLB header: {p}')\n",
    "        continue\n",
    "    validated.append(p)\n",
    "if not validated:\n",
    "    raise RuntimeError('No valid GLB files passed validation; nothing was uploaded.')\n",
    "\n",
    "api = HfApi(token=hf_token)\n",
    "api.create_repo(repo_id=DATASET_ID, repo_type='dataset', private=True, exist_ok=True)\n",
    "dataset_info = api.repo_info(repo_id=DATASET_ID, repo_type='dataset')\n",
    "if not getattr(dataset_info, 'private', False):\n",
    "    raise RuntimeError('The Hugging Face Dataset is PUBLIC. Set its visibility to Private in Hugging Face settings before uploading; this notebook will not upload game assets to a public Dataset.')\n",
    "stamp = time.strftime('%Y%m%d-%H%M%S', time.gmtime())\n",
    "uploaded = []\n",
    "for p in validated:\n",
    "    dest = f'generated/{stamp}/{p.parent.name}/textured_mesh.glb'\n",
    "    api.upload_file(path_or_fileobj=str(p), path_in_repo=dest, repo_id=DATASET_ID, repo_type='dataset', commit_message=f'Add Hunyuan3D asset {p.parent.name}')\n",
    "    uploaded.append({'local_file': str(p), 'dataset_path': dest, 'bytes': p.stat().st_size})\n",
    "manifest = {'model':'Tencent Hunyuan3D 2.1', 'created_utc':stamp, 'dataset':DATASET_ID, 'assets':uploaded}\n",
    "manifest_path = OUT_DIR / f'upload_manifest_{stamp}.json'\n",
    "manifest_path.write_text(json.dumps(manifest, indent=2), encoding='utf-8')\n",
    "api.upload_file(path_or_fileobj=str(manifest_path), path_in_repo=f'generated/{stamp}/upload_manifest.json', repo_id=DATASET_ID, repo_type='dataset', commit_message='Add Hunyuan3D asset manifest')\n",
    "print(f'SUCCESS: uploaded {len(uploaded)} validated GLB file(s) to https://huggingface.co/datasets/{DATASET_ID}')\n",
    "for item in uploaded:\n",
    "    print(item['dataset_path'], item['bytes'], 'bytes')\n",
    "del hf_token, secrets\n",
    ""
