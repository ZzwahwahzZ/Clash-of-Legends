; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters in here are not all obvious.

config_version=5

[application]

config/name="Clash of Legends"
config/name_localized={
"ar": "صراع الأساطير",
"en": "Clash of Legends"
}
config/description="Clash of Legends - 3D Android MMORPG inspired by Conquer Online Mobile, featuring offline local progression, full Arabic localization, 3D combat, and Godot 4.3 suite."
config/version="1.0.2"
run/main_scene="res://scenes/ui/LegendIntro.tscn"
run/max_fps=30
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://public/clash_launcher_icon.svg"

[autoload]

GameManager="*res://scripts/core/GameManager.gd"
ClassProgressionManager="*res://scripts/progression/ClassProgressionManager.gd"
GameContentDatabase="*res://scripts/core/GameContentDatabase.gd"
FeatureGuidanceManager="*res://scripts/ui/FeatureGuidanceManager.gd"
LocalSaveEngine="*res://scripts/core/LocalSaveEngine.gd"
ResourcePackManager="*res://scripts/core/ResourcePackManager.gd"
AssetCatalog="*res://scripts/core/AssetCatalog.gd"
GameAudioManager="*res://scripts/core/GameAudioManager.gd"
CombatEngine="*res://scripts/combat/CombatEngine.gd"
AutoHuntManager="*res://scripts/automation/AutoHuntManager.gd"
AutoLootManager="*res://scripts/automation/AutoLootManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[internationalization]

locale/fallback="ar"
locale/test="ar"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.18, 1)

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=1

[navigation]

3d/default_cell_height=0.1
3d/default_cell_size=0.25
