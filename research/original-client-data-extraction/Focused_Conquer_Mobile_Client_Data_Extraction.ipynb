      "source": [
        "# @title استخراج بيانات عميل Conquer Mobile فقط — فحص انتقائي دون إعادة الجرد\n# خلية واحدة فقط. لا تعيد فحص Manifest ولا ملفات الصور/النماذج ولا بقية الأرشيف.\n# تستخدم HTTP Range لقراءة فهرس ZIP وسحب ملفات APK الأربعة المحددة فقط.\nimport os, sys, json, csv, re, io, hashlib, zipfile, subprocess, textwrap, getpass, time\nfrom pathlib import Path\nfrom datetime import datetime, timezone\n\nprint(\"تهيئة فحص بيانات العميل المحدد فقط...\")\nimport requests\n\nSOURCE_URL = \"https://github.com/ZzwahwahzZ/Conquer-Mobile-Assets./releases/download/mobile-extracted-assets/extracted-assets-001.zip\"\nSOURCE_BYTES = 842723106\nSOURCE_SHA256 = \"0d21a110c09b762ed5f1a5f4da022857b0534e489eb85052d15da460cb229d2a\"\nTARGET_REPO = \"ZzwahwahzZ/Clash-of-Legends\"\nOUT = Path(\"/content/conquer_mobile_client_data_audit\")\nOUT.mkdir(parents=True, exist_ok=True)\n\n# هذه هي ملفات العميل وحدها التي سبق التحقق من وجودها داخل الأرشيف.\nTARGET_APKS = {\n    \"ConquerOnline/ConquerOnline-1.1.2.3.apk\",\n    \"ConquerOnline/config.arm64_v8a.apk\",\n    \"ConquerOnline/config.xxhdpi.apk\",\n    \"ConquerOnline/install_time_1001.apk\",\n}\nKEYWORDS = [\n    \"quest\",\"mission\",\"task\",\"map\",\"monster\",\"npc\",\"item\",\"skill\",\"equip\",\n    \"class\",\"profession\",\"job\",\"guild\",\"clan\",\"arena\",\"dungeon\",\"event\",\n    \"shop\",\"trade\",\"market\",\"refine\",\"socket\",\"gem\",\"enchant\",\"purify\",\n    \"bless\",\"soul\",\"wing\",\"pet\",\"mount\",\"drop\",\"reward\",\"teleport\",\n    \"任务\",\"地图\",\"怪物\",\"技能\",\"装备\",\"任务系统\",\"副本\",\"活动\",\"商店\",\"帮派\"\n]\nTEXT_EXT = {\".txt\",\".ini\",\".cfg\",\".json\",\".xml\",\".csv\",\".lua\",\".js\",\".yaml\",\".yml\",\".properties\",\".dat\"}\nMAX_TEXT_FILE = 2 * 1024 * 1024\nMAX_TEXT_FILES_PER_APK = 160\n\ndef sha256(data):\n    return hashlib.sha256(data).hexdigest()\n\ndef classify(path):\n    p = path.lower()\n    groups = {\n      \"maps_world\": [\"map\",\"scene\",\"terrain\",\"world\",\"city\",\"dungeon\",\"teleport\"],\n      \"quests_tasks\": [\"quest\",\"mission\",\"task\",\"dialog\",\"story\",\"objective\"],\n      \"characters_npc_monsters\": [\"npc\",\"monster\",\"mob\",\"role\",\"character\",\"avatar\"],\n      \"items_equipment\": [\"item\",\"equip\",\"weapon\",\"armor\",\"fashion\",\"wing\",\"mount\",\"pet\"],\n      \"skills_combat\": [\"skill\",\"magic\",\"spell\",\"combat\",\"effect\",\"buff\"],\n      \"economy_social\": [\"shop\",\"trade\",\"market\",\"guild\",\"clan\",\"arena\",\"event\"],\n      \"game_config\": [\"config\",\"setting\",\"table\",\"data\",\"define\",\"string\",\"text\"]\n    }\n    for category, words in groups.items():\n        if any(w in p for w in words):\n            return category\n    return \"other\"\n\ndef candidate_hits(text):\n    low = text.lower()\n    return [k for k in KEYWORDS if k.lower() in low]\n\n# احصل على رابط أصل الإصدار من GitHub API في كل تشغيل؛ لا نخزن رابط release-assets المؤقت.\n# هذا يمنع استخدام رابط موقّع قديم انتهت صلاحيته. لا يتم تنزيل الأرشيف كاملًا.\nAPI_HEADERS = {\n    \"Accept\": \"application/vnd.github+json\",\n    \"X-GitHub-Api-Version\": \"2022-11-28\",\n    \"User-Agent\": \"Clash-of-Legends-focused-client-audit\",\n    \"Cache-Control\": \"no-cache\"\n}\nsession = requests.Session()\nsession.headers.update(API_HEADERS)\nrelease_api = \"https://api.github.com/repos/ZzwahwahzZ/Conquer-Mobile-Assets./releases/tags/mobile-extracted-assets\"\nrelease_response = session.get(release_api, timeout=45)\nrelease_response.raise_for_status()\nrelease = release_response.json()\nasset = next((a for a in release.get(\"assets\", []) if a.get(\"name\") == \"extracted-assets-001.zip\"), None)\nif not asset:\n    raise RuntimeError(\"لم أجد extracted-assets-001.zip بالاسم المحدد داخل إصدار mobile-extracted-assets.\")\nif int(asset.get(\"size\", -1)) != SOURCE_BYTES:\n    raise RuntimeError(f\"حجم أصل GitHub الحالي ({asset.get('size')}) لا يطابق الحجم المثبت ({SOURCE_BYTES}).\")\n\nASSET_API_URL = f\"https://api.github.com/repos/ZzwahwahzZ/Conquer-Mobile-Assets./releases/assets/{asset['id']}\"\nprint(\"حجم المصدر المعلن:\", asset[\"size\"], \"| أصل الإصدار:\", asset[\"name\"])\nprint(\"تجديد رابط التنزيل المؤقت والتحقق من Range...\")\nrange_headers = dict(API_HEADERS)\nrange_headers[\"Accept\"] = \"application/octet-stream\"\nprobe = session.get(ASSET_API_URL, headers={**range_headers, \"Range\":\"bytes=0-0\"},\n                    allow_redirects=True, stream=True, timeout=60)\nif probe.status_code != 206:\n    status, detail = probe.status_code, probe.headers.get(\"Content-Range\", \"لا يوجد Content-Range\")\n    probe.close()\n    raise RuntimeError(f\"GitHub API لم يؤكد Range (HTTP {status}; {detail}). أوقفت التنفيذ دون تنزيل الأرشيف كاملًا.\")\ncontent_range = probe.headers.get(\"Content-Range\", \"\")\nprobe_type = probe.headers.get(\"Content-Type\", \"\")\nprobe_final_url = probe.url\nprobe.close()\nif not content_range.startswith(\"bytes 0-0/\"):\n    raise RuntimeError(\"استجابة Range غير مطابقة؛ أوقفت التنفيذ لحماية وقتك وحجم البيانات.\")\n\n# RemoteZip يستخدم session.headers الافتراضية، وليس range_headers المحلية.\n# يجب أن يطلب بايتات ZIP صراحةً بدل JSON metadata من GitHub API.\nsession.headers.update({\"Accept\": \"application/octet-stream\"})\n\nprint(\"Range probe:\", content_range, \"| Content-Type:\", probe_type, \"| final URL:\", probe_final_url.split(\"?\")[0])\nprint(\"تم تأكيد دعم النطاقات الصريحة؛ سيتم تجاوز RemoteZip لتجنب suffix-range الذي يرفضه CDN.\")\n\n# قارئ ZIP بعيد يطلب نطاقات bytes صريحة فقط (start-end)، ولا يستخدم bytes=-N.\n# zipfile يقرأ فهرس ZIP وأعضاء APK المطلوبة عبر seek/read دون تنزيل الأرشيف كاملًا.\nclass ExplicitHTTPRangeReader:\n    def __init__(self, url, http_session, total_size):\n        self.url = url\n        self.session = http_session\n        self.size = int(total_size)\n        self.pos = 0\n        self.closed = False\n        self.requests_made = 0\n        self.bytes_received = 0\n\n    def tell(self):\n        return self.pos\n\n    def seek(self, offset, whence=0):\n        if whence == 0:\n            new_pos = offset\n        elif whence == 1:\n            new_pos = self.pos + offset\n        elif whence == 2:\n            new_pos = self.size + offset\n        else:\n            raise ValueError(\"Invalid whence\")\n        if new_pos < 0:\n            raise ValueError(\"Negative seek position\")\n        self.pos = min(int(new_pos), self.size)\n        return self.pos\n\n    def readable(self):\n        return True\n\n    def seekable(self):\n        return True\n\n    def read(self, n=-1):\n        if self.closed:\n            raise ValueError(\"I/O operation on closed file\")\n        if n is None or n < 0:\n            n = self.size - self.pos\n        if n == 0 or self.pos >= self.size:\n            return b\"\"\n        start = self.pos\n        end = min(start + int(n), self.size) - 1\n        headers = {\"Accept\": \"application/octet-stream\", \"Range\": f\"bytes={start}-{end}\"}\n        response = self.session.get(self.url, headers=headers, allow_redirects=True,\n                                    stream=False, timeout=120)\n        try:\n            if response.status_code != 206:\n                raise RuntimeError(\n                    f\"فشل Range الصريح bytes={start}-{end}: HTTP {response.status_code}; \"\n                    f\"Content-Range={response.headers.get('Content-Range')}; \"\n                    f\"Content-Type={response.headers.get('Content-Type')}\"\n                )\n            actual_range = response.headers.get(\"Content-Range\", \"\")\n            expected_prefix = f\"bytes {start}-{end}/\"\n            if not actual_range.startswith(expected_prefix):\n                raise RuntimeError(\n                    f\"Content-Range غير مطابق. المطلوب {expected_prefix} لكن وصل {actual_range}\"\n                )\n            data = response.content\n            expected_len = end - start + 1\n            if len(data) != expected_len:\n                raise RuntimeError(\n                    f\"حجم الاستجابة غير مطابق: المتوقع {expected_len} بايت، وصل {len(data)}\"\n                )\n            self.requests_made += 1\n            self.bytes_received += len(data)\n            self.pos = end + 1\n            return data\n        finally:\n            response.close()\n\n    def close(self):\n        self.closed = True\n\n    @property\n    def name(self):\n        return \"github-release-explicit-http-range\"\n\nprint(\"قراءة فهرس ZIP بنطاقات صريحة فقط، دون فك بقية الأرشيف...\")\napk_reports, inventory_rows, text_rows, dex_candidates = [], [], [], []\nrange_reader = ExplicitHTTPRangeReader(ASSET_API_URL, session, SOURCE_BYTES)\nwith zipfile.ZipFile(range_reader, \"r\") as rz:\n    names = set(rz.namelist())\n    missing = sorted(TARGET_APKS - names)\n    if missing:\n        raise RuntimeError(\"ملفات APK المستهدفة غير موجودة: \" + \", \".join(missing))\n    selected = sorted(TARGET_APKS)\n    print(\"ملفات APK المحددة:\", len(selected))\n    for index, apk_path in enumerate(selected, 1):\n        print(f\"[{index}/{len(selected)}] سحب وتحليل {apk_path}\")\n        apk_bytes = rz.read(apk_path)  # قراءة عضو APK فقط من الأرشيف البعيد\n        apk_sha = sha256(apk_bytes)\n        apk_name = Path(apk_path).name\n        apk_info = {\n            \"archive_path\": apk_path, \"file\": apk_name, \"bytes\": len(apk_bytes),\n            \"sha256\": apk_sha, \"inner_file_count\": 0, \"dex_count\": 0,\n            \"text_files_read\": 0, \"keyword_candidate_count\": 0,\n            \"categories\": {}\n        }\n        with zipfile.ZipFile(io.BytesIO(apk_bytes)) as apk:\n            infos = [i for i in apk.infolist() if not i.is_dir()]\n            apk_info[\"inner_file_count\"] = len(infos)\n            for info in infos:\n                name = info.filename\n                category = classify(name)\n                ext = Path(name).suffix.lower()\n                inventory_rows.append({\n                    \"apk\": apk_name, \"path\": name, \"bytes\": info.file_size,\n                    \"compressed_bytes\": info.compress_size, \"extension\": ext,\n                    \"category\": category, \"crc32\": f\"{info.CRC:08x}\"\n                })\n                apk_info[\"categories\"][category] = apk_info[\"categories\"].get(category, 0) + 1\n\n                # نصوص DEX: استخراج سلاسل UTF-8/ASCII المطبوعة فقط، بلا فك أو تعديل للتطبيق.\n                if re.fullmatch(r\"classes\\d*\\.dex\", Path(name).name):\n                    dex = apk.read(info)\n                    apk_info[\"dex_count\"] += 1\n                    strings = re.findall(rb\"[\\x20-\\x7e]{5,}\", dex)\n                    for raw in strings:\n                        s = raw.decode(\"utf-8\", \"ignore\").strip()\n                        hits = candidate_hits(s)\n                        if hits:\n                            dex_candidates.append({\n                                \"apk\": apk_name, \"dex\": name,\n                                \"keywords\": \"|\".join(hits), \"candidate\": s[:700]\n                            })\n\n                # قراءة الملفات النصية الصغيرة ذات الصلة فقط، مع حد أقصى واضح.\n                if (ext in TEXT_EXT and info.file_size <= MAX_TEXT_FILE\n                    and apk_info[\"text_files_read\"] < MAX_TEXT_FILES_PER_APK\n                    and (category != \"other\" or name.lower().startswith((\"assets/\",\"res/raw/\",\"res/xml/\")))):\n                    try:\n                        raw = apk.read(info)\n                        decoded = raw.decode(\"utf-8-sig\")\n                        if decoded and \"\\x00\" not in decoded[:2000]:\n                            hits = candidate_hits(name + \"\\n",
        "\" + decoded[:200000])\n                            text_rows.append({\n                                \"apk\": apk_name, \"path\": name,\n                                \"bytes\": info.file_size, \"category\": category,\n                                \"keywords\": \"|\".join(hits),\n                                \"content_preview\": decoded[:12000]\n                            })\n                            apk_info[\"text_files_read\"] += 1\n                    except Exception:\n                        pass\n        apk_reports.append(apk_info)\n        del apk_bytes\n\n# ملفات نتائج مستقلة؛ لا نلمس تقارير Manifest السابقة.\ngenerated = datetime.now(timezone.utc).isoformat()\nsummary = {\n    \"generated_utc\": generated,\n    \"task\": \"focused_original_mobile_client_data_extraction\",\n    \"scope\": \"Only the four known ConquerOnline APK members; explicit HTTP byte ranges; no full archive extraction or previous manifest re-audit.\",\n    \"source\": {\"release_tag\": \"mobile-extracted-assets\", \"asset_name\": \"extracted-assets-001.zip\",\n               \"asset_id\": asset[\"id\"], \"expected_bytes\": SOURCE_BYTES, \"expected_sha256\": SOURCE_SHA256,\n               \"range_verified\": True, \"range_content_header\": content_range, \"range_reader\": \"explicit_byte_ranges_no_suffix_ranges\", \"range_requests\": range_reader.requests_made, \"range_bytes_received\": range_reader.bytes_received, \"full_archive_downloaded\": False},\n    \"apk_files_analyzed\": len(apk_reports),\n    \"apk_reports\": apk_reports,\n    \"internal_file_inventory_count\": len(inventory_rows),\n    \"text_files_read_count\": len(text_rows),\n    \"dex_keyword_candidate_count\": len(dex_candidates),\n    \"limitations\": [\n      \"DEX strings are discovery clues, not proof of complete game-system behavior.\",\n      \"Encrypted, compressed, proprietary or server-delivered data may require a separate format-specific stage.\",\n      \"No source APK was modified.\"\n    ]\n}\n(OUT/\"client-data-summary.json\").write_text(json.dumps(summary,ensure_ascii=False,indent=2),encoding=\"utf-8\")\nwith (OUT/\"apk-internal-inventory.csv\").open(\"w\",newline=\"\",encoding=\"utf-8-sig\") as f:\n    w=csv.DictWriter(f,fieldnames=[\"apk\",\"path\",\"bytes\",\"compressed_bytes\",\"extension\",\"category\",\"crc32\"])\n    w.writeheader(); w.writerows(inventory_rows)\nwith (OUT/\"dex-system-keyword-candidates.csv\").open(\"w\",newline=\"\",encoding=\"utf-8-sig\") as f:\n    w=csv.DictWriter(f,fieldnames=[\"apk\",\"dex\",\"keywords\",\"candidate\"])\n    w.writeheader(); w.writerows(dex_candidates)\nwith (OUT/\"embedded-text-candidates.jsonl\").open(\"w\",encoding=\"utf-8\") as f:\n    for row in text_rows: f.write(json.dumps(row,ensure_ascii=False)+\"\\n",
        "\")\n\n# حزمة النتائج الصغيرة للتنزيل؛ لا تضم APKs ولا تعيد رفع ملفات العميل الأصلية.\nbundle = Path(\"/content/Conquer-Mobile-Client-Data-Audit.zip\")\nwith zipfile.ZipFile(bundle,\"w\",zipfile.ZIP_DEFLATED,compresslevel=6) as z:\n    for p in sorted(OUT.iterdir()):\n        if p.is_file(): z.write(p,p.name)\n\nprint(\"\\n",
        "اكتمل التحليل الانتقائي.\")\nprint(\"APK:\",len(apk_reports),\"| ملفات داخلية مفهرسة:\",len(inventory_rows),\n      \"| نصوص مقروءة:\",len(text_rows),\"| مرشحات DEX:\",len(dex_candidates))\nprint(\"حزمة النتائج:\",bundle)\n\n# رفع التقارير النصية الصغيرة إلى مجلد جديد في مستودع اللعبة (يتطلب GitHub PAT بصلاحية Contents: write).\n# لا يتم رفع أي APK أو أصل أصلي أو ملف كبير.\ntoken = getpass.getpass(\"GitHub PAT (Contents: Read and write) لرفع التقارير إلى مستودع اللعبة، أو Enter للتخطي: \").strip()\nif token:\n    api = f\"https://api.github.com/repos/{TARGET_REPO}/contents\"\n    dest = \"research/original-client-data-extraction\"\n    headers = {\"Authorization\":f\"Bearer {token}\",\"Accept\":\"application/vnd.github+json\",\"X-GitHub-Api-Version\":\"2022-11-28\"}\n    uploaded = []\n    for p in sorted(OUT.iterdir()):\n        if not p.is_file(): continue\n        raw = p.read_bytes()\n        if len(raw) > 8_000_000:\n            print(\"تخطي ملف كبير:\",p.name); continue\n        path = f\"{dest}/{p.name}\"\n        old = requests.get(f\"{api}/{path}\",headers=headers,params={\"ref\":\"main\"},timeout=45)\n        payload = {\"message\":f\"Add focused original client data audit: {p.name}\",\n                   \"content\":__import__(\"base64\").b64encode(raw).decode(\"ascii\"),\n                   \"branch\":\"main\"}\n        if old.status_code == 200:\n            payload[\"sha\"] = old.json()[\"sha\"]\n        elif old.status_code not in (404,):\n            raise RuntimeError(f\"تعذر قراءة حالة {path}: {old.status_code} {old.text[:300]}\")\n        put = requests.put(f\"{api}/{path}\",headers=headers,json=payload,timeout=90)\n        if put.status_code not in (200,201):\n            raise RuntimeError(f\"فشل رفع {path}: {put.status_code} {put.text[:500]}\")\n        uploaded.append(path)\n    print(\"تم رفع التقارير:\",uploaded)\nelse:\n    print(\"تم تخطي الرفع. التقارير موجودة في:\",OUT)\n\ntry:\n    from google.colab import files\n    files.download(str(bundle))\nexcept Exception:\n    print(\"نزّل الملف يدويًا من:\",bundle)\n"
      ]
    }
